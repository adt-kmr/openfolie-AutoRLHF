# autorlhf credentials - EXAMPLE ONLY. Copy values into the real file, do not
# edit this one.
#
# The real secret file lives at ~/.local/share/autorlhf/config.env on Linux
# (or $AUTORLHF_HOME/config.env). `autorlhf --setup` writes it with 0600
# permissions. A project-local `.env` in the working directory is *read* as a
# lowest-precedence fallback but is never written by autorlhf, and `.env` is
# gitignored - never commit real keys.
#
# Real environment variables always win over both files (useful for CI).

# --- OpenRouter (required) ------------------------------------------------- #
# Used for synthetic prompt/response generation and for Jev judgements.
OPENROUTER_API_KEY=

# --- Hugging Face (optional) ----------------------------------------------- #
# Only needed for gated or private model repositories.
HF_TOKEN=

# --- Weights & Biases (optional) ------------------------------------------- #
WANDB_ENABLED=false
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=

# --- Weave (optional; requires explicit consent) --------------------------- #
# Enabling Weave transmits prompts, responses and judgements off this machine.
WEAVE_ENABLED=false
WEAVE_PROJECT=
